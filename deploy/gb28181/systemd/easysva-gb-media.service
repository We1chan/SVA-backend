# 模块：流媒体协议组 / GB28181 独立媒体服务。
# 与原有 ZLMediaKit 使用不同配置、端口和日志，避免破坏 DIRECT/RTSP 链路。
[Unit]
Description=easySVA GB28181 ZLMediaKit
After=network.target
RequiresMountsFor=/mnt/d/Codex/easySVA

[Service]
Type=simple
Environment=EASYSVA_HOME=/mnt/d/Codex/easySVA
WorkingDirectory=/mnt/d/Codex/easySVA/SVA-mediaServer/release/linux/Release
ExecStart=/bin/bash -lc 'exec "$EASYSVA_HOME/SVA-mediaServer/release/linux/Release/MediaServer" -c "$EASYSVA_HOME/SVA-backend/deploy/gb28181/config/zlm-gb.local.ini"'
Restart=on-failure
RestartSec=3
StandardOutput=append:/opt/easySVA/logs/gb-media.log
StandardError=append:/opt/easySVA/logs/gb-media.log

[Install]
WantedBy=multi-user.target
